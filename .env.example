# Copy this file to .env, then put your key after API_KEY=. Never upload .env to GitHub.
# Two models: a chat model (writes the answers) and an embedding model (turns text into numbers for RAG).

## PART 1. Chat model. Gemini (https://aistudio.google.com/app/apikey)
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL_NAME=gemini-3.5-flash-lite
API_KEY=

## PART 2. Embedding model. Leave the URL and key empty to use the same server and key as PART 1.
EMBEDDING_MODEL_NAME=gemini-embedding-001
EMBEDDING_API_URL=
EMBEDDING_API_KEY=

## Or use NKUST for both parts (the embedding model name starts with a capital E)
# LLM_API_URL=https://www.iai.nkust.edu.tw/aihub/v1/
# MODEL_NAME=Furen-large
# API_KEY=
# EMBEDDING_MODEL_NAME=Embedding

## Optional: another seat sheet (CSV export link). Empty = the official vote-bus sheet.
SEAT_SHEET_CSV_URL=

## Optional: the order sheet (booking form answers) as a CSV export link. Empty = test orders in orders_test.csv.
## Never put the real link in a public file: anyone with it can read every order.
ORDER_SHEET_CSV_URL=

## Optional: log out after this many seconds without a message (default 1800), and users served at once (default 8).
SESSION_SECONDS=
CONCURRENCY=
